# PostgreSQL connection string (docker-compose maps the local dev Postgres to host port 5433
# to avoid clashing with any other Postgres instance you may already have on 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/portfolio?schema=public"

# Server
PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Seed admin user (used only by prisma/seed.ts)
SEED_ADMIN_EMAIL="jirat.sitthiwetkiat@gmail.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Jirat Sitthiwetkiat"

# Uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5
