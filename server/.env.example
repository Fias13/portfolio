# PostgreSQL connection string (docker-compose maps the local dev Postgres to host port 5433
# to avoid clashing with any other Postgres instance you may already have on 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/portfolio?schema=public"

# Server
PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Seed admin user (used only by prisma/seed.ts)
SEED_ADMIN_EMAIL="jirat.sitthiwetkiat@gmail.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Jirat Sitthiwetkiat"

# Uploads
# Local disk fallback (used only when SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY below are unset —
# fine for local dev, but NOT persistent across redeploys on most hosting platforms)
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5

# Supabase Storage (recommended for production — set these to upload media to a persistent
# Supabase Storage bucket instead of local disk. Get them from Supabase → Project Settings → API.
# SUPABASE_SERVICE_ROLE_KEY is a secret key with full access — never expose it to the frontend.)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="portfolio-media"
