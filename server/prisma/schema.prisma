generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  FREELANCE
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Profile {
  id            String   @id @default(cuid())
  name          String
  headlineEn    String
  headlineTh    String
  bioEn         String   @db.Text
  bioTh         String   @db.Text
  email         String
  phone         String?
  location      String?
  github        String?
  linkedin      String?
  website       String?
  resumeUrl     String?
  avatarUrl     String?
  availableForWork Boolean @default(true)
  updatedAt     DateTime @updatedAt
}

model Project {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  shortDescEn     String
  shortDescTh     String
  fullDescEn      String   @db.Text
  fullDescTh      String   @db.Text
  role            String?
  year            Int?
  category        String?
  techStack       String[] @default([])
  features        String[] @default([])
  problemEn       String?  @db.Text
  problemTh       String?  @db.Text
  solutionEn      String?  @db.Text
  solutionTh      String?  @db.Text
  challengesEn    String?  @db.Text
  challengesTh    String?  @db.Text
  resultsEn       String?  @db.Text
  resultsTh       String?  @db.Text
  githubUrl       String?
  liveDemoUrl     String?
  thumbnailUrl    String?
  featured        Boolean  @default(false)
  published       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  images          ProjectImage[]

  @@index([published, sortOrder])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int      @default(0)

  @@index([projectId])
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  category    String
  icon        String?
  descriptionEn String?
  descriptionTh String?
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, sortOrder])
}

model Experience {
  id             String   @id @default(cuid())
  company        String
  position       String
  employmentType EmploymentType @default(INTERNSHIP)
  startDate      DateTime
  endDate        DateTime?
  isPresent      Boolean  @default(false)
  descriptionEn  String   @db.Text
  descriptionTh  String   @db.Text
  responsibilities String[] @default([])
  technologies   String[] @default([])
  location       String?
  sortOrder      Int      @default(0)
  visible        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Achievement {
  id            String   @id @default(cuid())
  titleEn       String
  titleTh       String
  organization  String
  date          DateTime
  descriptionEn String?  @db.Text
  descriptionTh String?  @db.Text
  imageUrl      String?
  credentialUrl String?
  event         String?
  project       String?
  role          String?
  featured      Boolean  @default(false)
  visible       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Certificate {
  id            String   @id @default(cuid())
  name          String
  organization  String
  issueDate     DateTime
  credentialId  String?
  credentialUrl String?
  imageUrl      String?
  descriptionEn String?
  descriptionTh String?
  visible       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlogPost {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  excerptEn     String
  excerptTh     String
  contentEn     String   @db.Text
  contentTh     String   @db.Text
  coverImageUrl String?
  status        BlogStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tags          BlogTag[] @relation("BlogPostToBlogTag")
}

model BlogTag {
  id    String     @id @default(cuid())
  name  String     @unique
  posts BlogPost[] @relation("BlogPostToBlogTag")
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  message   String        @db.Text
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
}

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimeType  String
  size      Int
  folder    String?
  createdAt DateTime @default(now())
}

model SiteSetting {
  id                String   @id @default("singleton")
  siteTitle         String   @default("Jirat Sitthiwetkiat — Junior Frontend Developer")
  siteDescriptionEn String   @db.Text
  siteDescriptionTh String   @db.Text
  seoKeywords       String[] @default([])
  favicon           String?
  defaultLanguage   String   @default("en")
  defaultTheme      String   @default("dark")
  contactEmail      String?
  socialLinks       Json?
  updatedAt         DateTime @updatedAt
}
